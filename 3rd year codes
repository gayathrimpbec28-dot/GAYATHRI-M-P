 */
char* isBalanced(char* s) {
    int len = strlen(s);
    
    // Allocate a tracking stack array matching the string length capacity bounds
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;

    for (int i = 0; i < len; i++) {
        char ch = s[i];
        
        // Push opening brackets onto the stack
        if (ch == '(' || ch == '[' || ch == '{') {
            stack[++top] = ch;
        } 
        // Evaluate closing brackets against the stack top
        else if (ch == ')' || ch == ']' || ch == '}') {
            // Unbalanced if a closing bracket is found but stack is empty
            if (top == -1) {
                free(stack);
                return "NO";
            }
            
            char open = stack[top--];
            // Check for structural mismatch errors
            if ((ch == ')' && open != '(') ||
                (ch == ']' && open != '[') ||
                (ch == '}' && open != '{')) {
                free(stack);
                return "NO";
            }
        }
    }

    // It is only balanced if the stack is completely empty at the end
    bool balanced = (top == -1);
    free(stack);
    
    return balanced ? "YES" : "NO";
}

