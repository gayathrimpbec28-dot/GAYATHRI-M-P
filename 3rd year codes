int* solve(int arr_count, int* arr, int queries_count, int* queries, int* result_count) {
    // Allocate memory for the final output answers list
    int* result = (int*)malloc(queries_count * sizeof(int));
    *result_count = queries_count;

    // Allocate an index tracker array to act as a double-ended queue (deque)
    int* deque = (int*)malloc(arr_count * sizeof(int));

    for (int q = 0; q < queries_count; q++) {
        int d = queries[q];
        int head = 0;
        int tail = 0;
        int min_of_maxes = INT_MAX;

        for (int i = 0; i < arr_count; i++) {
            // Remove elements out of the current sliding window frame range from front
            if (head < tail && deque[head] < i - d + 1) {
                head++;
            }

            // Remove elements smaller than the currently incoming item from back
            while (head < tail && arr[deque[tail - 1]] <= arr[i]) {
                tail--;
            }

            // Insert current index into the deque
            deque[tail++] = i;

            // Once we have a complete initial window frame size, track the min of max values
            if (i >= d - 1) {
                int current_max = arr[deque[head]];
                if (current_max < min_of_maxes) {
                    min_of_maxes = current_max;
                }
            }
        }
        result[q] = min_of_maxes;
    }

    free(deque);
    return result;
}

