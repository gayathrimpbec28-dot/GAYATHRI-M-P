#include <stdlib.h>

struct ListNode* addTwoNumbers(struct ListNode* l1, struct ListNode* l2) {
    // 1. Create a dummy head node to simplify list construction
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = NULL;
    struct ListNode* curr = &dummy;
    
    int carry = 0;

    // 2. Loop through both lists until everything is processed, including any final carry
    while (l1 != NULL || l2 != NULL || carry != 0) {
        int sum = carry;

        if (l1 != NULL) {
            sum += l1->val;
            l1 = l1->next;
        }

        if (l2 != NULL) {
            sum += l2->val;
            l2 = l2->next;
        }

        // Calculate the new carry and the single-digit value for the new node
        carry = sum / 10;
        
        // Allocate memory for the new node
        struct ListNode* newNode = (struct ListNode*)malloc(sizeof(struct ListNode));
        newNode->val = sum % 10;
        newNode->next = NULL;

        // Attach the new node to the result list
        curr->next = newNode;
        curr = curr->next;
    }

    // Return the actual head, skipping the dummy placeholder node
    return dummy.next;
}
