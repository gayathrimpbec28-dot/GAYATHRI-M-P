#include <stdbool.h>

bool isPalindrome(int x) {
    // Negative numbers are not palindromes (due to the '-' sign)
    // Numbers ending in 0 are not palindromes, except 0 itself
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    int reversedHalf = 0;
    // Reverse the digits of the second half of the number
    while (x > reversedHalf) {
        reversedHalf = (reversedHalf * 10) + (x % 10);
        x /= 10;
    }
    // For even length numbers: x == reversedHalf
    // For odd length numbers: x == reversedHalf / 10 (removes the middle digit)
    return x == reversedHalf || x == reversedHalf / 10;
}
