#include <stdlib.h>

#define HASH_SIZE 20033 // A prime number larger than the maximum array size constraint

typedef struct HashNode {
    int key;
    int value;
    struct HashNode* next;
} HashNode;

// Helper function to insert into the hash table
void insert(HashNode** hashTable, int key, int value) {
    int hashIndex = abs(key) % HASH_SIZE;
    HashNode* newNode = (HashNode*)malloc(sizeof(HashNode));
    newNode->key = key;
    newNode->value = value;
    newNode->next = hashTable[hashIndex];
    hashTable[hashIndex] = newNode;
}

// Helper function to search the hash table
HashNode* search(HashNode** hashTable, int key) {
    int hashIndex = abs(key) % HASH_SIZE;
    HashNode* curr = hashTable[hashIndex];
    while (curr != NULL) {
        if (curr->key == key) {
            return curr;
        }
        curr = curr->next;
    }
    return NULL;
}

int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    // 1. Allocate memory for the hash table and clear it
    HashNode** hashTable = (HashNode**)calloc(HASH_SIZE, sizeof(HashNode*));
    
    // 2. Allocate the result array
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;

    // 3. Traverse the array to find the target pair
    for (int i = 0; i < numsSize; i++) {
        int complement = target - nums[i];
        HashNode* found = search(hashTable, complement);
        
        if (found != NULL) {
            result[0] = found->value;
            result[1] = i;
            
            // Free allocated hash table memory before returning
            for (int j = 0; j < HASH_SIZE; j++) {
                HashNode* curr = hashTable[j];
                while (curr != NULL) {
                    HashNode* temp = curr;
                    curr = curr->next;
                    free(temp);
                }
            }
            free(hashTable);
            return result;
        }
        
        insert(hashTable, nums[i], i);
    }

    // Free hash table if no solution is found (though the problem guarantees one)
    free(hashTable);
    *returnSize = 0;
    return NULL;
}
