#include <stdlib.h>

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */

// Helper function to recursively perform preorder traversal
void traverse(struct TreeNode* root, int* arr, int* size) {
    if (root == NULL) {
        return;
    }
    
    // Process root node first (Root -> Left -> Right)
    arr[(*size)++] = root->val;
    
    // Traverse left subtree
    traverse(root->left, arr, size);
    
    // Traverse right subtree
    traverse(root->right, arr, size);
}

int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    // Allocate maximum potential nodes buffer (e.g., 100 nodes for LeetCode constraints)
    int* result = (int*)malloc(100 * sizeof(int));
    *returnSize = 0;
    
    traverse(root, result, returnSize);
    
    return result;
}
