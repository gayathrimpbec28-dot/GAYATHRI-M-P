 *
 * The function is expected to return a LONG_INTEGER.
 * The function accepts INTEGER_ARRAY h as parameter.
 */
long largestRectangle(int h_count, int* h) {
    // Stack to store indices of buildings
    int* stack = (int*)malloc((h_count + 1) * sizeof(int));
    int top = -1;
    long max_area = 0;
    
    int i = 0;
    while (i < h_count) {
        // If stack is empty or current building is taller than the top building
        if (top == -1 || h[i] >= h[stack[top]]) {
            stack[++top] = i++;
        } else {
            // Pop the top building index
            int tp = stack[top--];
            
            // Calculate the width of the rectangle with h[tp] as the smallest height
            long width = (top == -1) ? i : (i - stack[top] - 1);
            long area = (long)h[tp] * width;
            
            if (area > max_area) {
                max_area = area;
            }
        }
    }
    
    // Process any remaining buildings left in the stack
    while (top != -1) {
        int tp = stack[top--];
        long width = (top == -1) ? i : (i - stack[top] - 1);
        long area = (long)h[tp] * width;
        
        if (area > max_area) {
            max_area = area;
        }
    }
    
    free(stack);
    return max_area;
}

