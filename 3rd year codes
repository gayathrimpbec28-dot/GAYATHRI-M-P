#define MAX_OPS 1000005
#define MAX_LEN 1000005

// Stack to hold history of string snapshots for Undo operations
char* history_stack[MAX_OPS];
int stack_top = -1;

void push_history(const char* current_str) {
    stack_top++;
    history_stack[stack_top] = strdup(current_str);
}

char* pop_history() {
    if (stack_top >= 0) {
        char* last_state = history_stack[stack_top];
        stack_top--;
        return last_state;
    }
    return NULL;
}

int main() {
    int q;
    if (scanf("%d", &q) != 1) return 0;

    // Allocate memory for the active string editor
    char* S = (char*)malloc(MAX_LEN * sizeof(char));
    S[0] = '\0';
    int S_len = 0;

    char append_buf[MAX_LEN];

    for (int i = 0; i < q; i++) {
        int type;
        scanf("%d", &type);

        if (type == 1) {
            // Append operation: Save state, then add string
            push_history(S);
            scanf("%s", append_buf);
            int append_len = strlen(append_buf);
            strcpy(S + S_len, append_buf);
            S_len += append_len;
        } 
        else if (type == 2) {
            // Delete operation: Save state, then shorten string lengths
            push_history(S);
            int k;
            scanf("%d", &k);
            S_len -= k;
            S[S_len] = '\0';
        } 
        else if (type == 3) {
            // Print operation: 1-indexed print target character
            int k;
            scanf("%d", &k);
            printf("%c\n", S[k - 1]);
        } 
        else if (type == 4) {
            // Undo operation: Revert to the last saved structural history
            char* previous_state = pop_history();
            if (previous_state != NULL) {
                strcpy(S, previous_state);
                S_len = strlen(S);
                free(previous_state); // Clean up popped memory
