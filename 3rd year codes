 */
int equalStacks(int h1_count, int* h1, int h2_count, int* h2, int h3_count, int* h3) {
    long long sum1 = 0, sum2 = 0, sum3 = 0;

    // Calculate total initial height for stack 1
    for (int i = 0; i < h1_count; i++) sum1 += h1[i];
    // Calculate total initial height for stack 2
    for (int i = 0; i < h2_count; i++) sum2 += h2[i];
    // Calculate total initial height for stack 3
    for (int i = 0; i < h3_count; i++) sum3 += h3[i];

    int i1 = 0, i2 = 0, i3 = 0;

    // Keep removing the top elements from the tallest stack until heights match
    while (sum1 != sum2 || sum2 != sum3) {
        // If any stack becomes empty, they can only equalize at height 0
        if (i1 == h1_count || i2 == h2_count || i3 == h3_count) {
            return 0;
