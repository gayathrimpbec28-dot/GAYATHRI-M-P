#include <stdlib.h>

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */
/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* inorderTraversal(struct TreeNode* root, int* returnSize) {
    int capacity = 100;
    int* result = (int*)malloc(capacity * sizeof(int));
    int size = 0;

    struct TreeNode* curr = root;
    while (curr != NULL) {
        if (curr->left == NULL) {
            // No left child: process current node and go right
            if (size >= capacity) {
                capacity *= 2;
                result = (int*)realloc(result, capacity * sizeof(int));
            }
            result[size++] = curr->val;
            curr = curr->right;
        } else {
            // Find the inorder predecessor of curr
            struct TreeNode* pred = curr->left;
            while (pred->right != NULL && pred->right != curr) {
                pred = pred->right;
            }

            if (pred->right == NULL) {
                // Create a temporary link to the successor
                pred->right = curr;
                curr = curr->left;
            } else {
                // Link already exists: break the link, process node, and go right
                pred->right = NULL;
                if (size >= capacity) {
                    capacity *= 2;
                    result = (int*)realloc(result, capacity * sizeof(int));
                }
                result[size++] = curr->val;
                curr = curr->right;
            }
        }
    }

    *returnSize = size;
    return result;
}
