        sprintf(newPath, "%s->%d", currentPath, node->val);
    }
    
    // If it's a leaf node, save the current constructed path to the result array
    if (node->left == NULL && node->right == NULL) {
        result[*returnSize] = malloc(strlen(newPath) + 1);
        strcpy(result[*returnSize], newPath);
        (*returnSize)++;
        return;
    }
    
    // Continue exploration down left and right subtrees
    dfs(node->left, newPath, result, returnSize);
    dfs(node->right, newPath, result, returnSize);
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
char** binaryTreePaths(struct TreeNode* root, int* returnSize) {
    *returnSize = 0;
    if (root == NULL) {
        return NULL;
    }
    
    // Constraints show max 100 nodes, so a maximum of 50 leaf nodes (paths) are possible
    char** result = (char**)malloc(100 * sizeof(char*));
    char initialPath[1] = "";
    
    dfs(root, initialPath, result, returnSize);
    
    return result;
}
