int twoStacks(int maxSum, int a_count, int* a, int b_count, int* b) {
    int countA = 0;
    int countB = 0;
    long long current_sum = 0;

    // Step 1: Pop as many items from stack 'a' as possible within maxSum bounds
    while (countA < a_count && current_sum + a[countA] <= maxSum) {
        current_sum += a[countA];
        countA++;
    }

    // Capture the maximum score using elements exclusively from stack 'a'
    int max_score = countA;

    // Step 2: Incrementally add elements from stack 'b'
    while (countB < b_count) {
        current_sum += b[countB];
        countB++;

        // Step 3: Shrink elements of stack 'a' if total sum slips out of bounds
        while (current_sum > maxSum && countA > 0) {
            countA--;
            current_sum -= a[countA];
        }

        // If the balance frame is valid, check the new cumulative maximum score
        if (current_sum <= maxSum) {
            int current_score = countA + countB;
            if (current_score > max_score) {
                max_score = current_score;
            }
        } else {
            // Terminate if maxSum is breached and stack 'a' has been emptied
            break;
        }
    }

    return max_score;
}

