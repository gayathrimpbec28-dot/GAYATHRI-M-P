class Solution:
    def buildArray(self, target: list[int], n: int) -> list[str]:
        operations = []
        target_idx = 0
        
        # Iterate through the stream from 1 to n
        for i in range(1, n + 1):
            # If we've matched all elements in target, stop early
            if target_idx == len(target):
                break
                
            if i == target[target_idx]:
                operations.append("Push")
                target_idx += 1
            else:
                operations.append("Push")
                operations.append("Pop")
                
        return operations
