int** levelOrder(struct TreeNode* root, int* returnSize, int** returnColumnSizes) {
    // Step 1: Handle empty tree base case
    if (root == NULL) {
        *returnSize = 0;
        *returnColumnSizes = NULL;
        return NULL;
    }

    // Step 2: Allocate memory for results
    int** result = (int**)malloc(2000 * sizeof(int*));
    *returnColumnSizes = (int*)malloc(2000 * sizeof(int));
    *returnSize = 0;

    // Step 3: Create fixed-size queue array
    struct TreeNode* queue[2001];
    int head = 0;
    int tail = 0;

    // Step 4: Add root to queue
    queue[tail++] = root;

    // Step 5: Process level by level
    while (head < tail) {
        int levelSize = tail - head;
        
        // Allocate space for current row
        result[*returnSize] = (int*)malloc(levelSize * sizeof(int));
        (*returnColumnSizes)[*returnSize] = levelSize;

        // Step 6: Process nodes in current level
        for (int i = 0; i < levelSize; i++) {
            struct TreeNode* current = queue[head++];
            result[*returnSize][i] = current->val;

            // Step 7: Push children to queue
            if (current->left != NULL) {
                queue[tail++] = current->left;
            }
            if (current->right != NULL) {
                queue[tail++] = current->right;
            }
        }
        
        // Step 8: Increment total level count
        (*returnSize)++;
    }

    return result;
}
