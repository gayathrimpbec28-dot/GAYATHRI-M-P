#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    char stack[len];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {
        char current = s[i];
        
        // Push opening brackets
        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        // Pop and validate closing brackets
        else {
            if (top == -1) return false;
            
            if (current == ')' && stack[top] != '(') return false;
            if (current == '}' && stack[top] != '{') return false;
            if (current == ']' && stack[top] != '[') return false;
            
            top--; // Match found, pop the stack
        }
    }

    return top == -1;
}

