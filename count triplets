#define HASH_SIZE 200003

// Hash Map Node definition for chaining
typedef struct MapNode {
    long key;
    long value;
    struct MapNode* next;
} MapNode;

// Hash function for long integers
unsigned int hash(long key) {
    unsigned long h = (unsigned long)key;
    h ^= (h >> 20) ^ (h >> 12);
    return (h ^ (h >> 7) ^ (h >> 4)) % HASH_SIZE;
}

// Find a key or return 0 if not found
long map_get(MapNode** table, long key) {
    unsigned int slot = hash(key);
    MapNode* curr = table[slot];
    while (curr != NULL) {
        if (curr->key == key) {
            return curr->value;
        }
        curr = curr->next;
    }
    return 0;
}

// Add a value to a key
void map_add(MapNode** table, long key, long delta) {
    unsigned int slot = hash(key);
    MapNode* curr = table[slot];
    while (curr != NULL) {
        if (curr->key == key) {
            curr->value += delta;
            return;
        }
        curr = curr->next;
    }
    MapNode* new_node = (MapNode*)malloc(sizeof(MapNode));
    new_node->key = key;
    new_node->value = delta;
    new_node->next = table[slot];
    table[slot] = new_node;
}

// Free hash table memory
void map_free(MapNode** table) {
    for (int i = 0; i < HASH_SIZE; i++) {
        MapNode* curr = table[i];
        while (curr != NULL) {
            MapNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
}

// Complete the countTriplets function below.
long countTriplets(int arr_count, long* arr, long r) {
    MapNode** potential_seconds = (MapNode**)calloc(HASH_SIZE, sizeof(MapNode*));
    MapNode** potential_thirds = (MapNode**)calloc(HASH_SIZE, sizeof(MapNode*));
    
    long triplet_count = 0;
    
    for (int i = 0; i < arr_count; i++) {
        long x = arr[i];
        
        // 1. If x completes a triplet
        triplet_count += map_get(potential_thirds, x);
        
        // 2. If x can extend a single element into a pair expecting (x * r)
        long sec_count = map_get(potential_seconds, x);
        if (sec_count > 0) {
            map_add(potential_thirds, x * r, sec_count);
        }
        
        // 3. x can be the start of a triplet, expecting (x * r) as the second element
        map_add(potential_seconds, x * r, 1);
    }
    
    map_free(potential_seconds);
    map_free(potential_thirds);
    free(potential_seconds);
    free(potential_thirds);
    
    return triplet_count;
}

