#include <limits.h>
#include <stdlib.h>

int divide(int dividend, int divisor) {
    // Handle the overflow edge case explicitly
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }
    
    // Determine the sign of the final result
    // Returns negative if signs are different, positive if they are the same
    int isNegative = (dividend < 0) ^ (divisor < 0);
    
    // Convert both numbers to negative values to prevent overflow during abs()
    // For example, abs(-2^31) cannot be represented in a 32-bit positive signed int
    long long absDividend = llabs((long long)dividend);
    long long absDivisor = llabs((long long)divisor);
    
    long long quotient = 0;
    
    // Perform bitwise long division
    while (absDividend >= absDivisor) {
        long long tempDivisor = absDivisor;
        long long multiple = 1;
        
        // Double the divisor using left shifts until it exceeds the remaining dividend
        while (absDividend >= (tempDivisor << 1)) {
            tempDivisor <<= 1;
            multiple <<= 1;
        }
        
        // Subtract the largest found multiple from the dividend
        absDividend -= tempDivisor;
        quotient += multiple;
    }
    
    // Apply the sign and return the final 32-bit integer result
    return isNegative ? -quotient : quotient;
}
