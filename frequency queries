#define HASH_SIZE 200003

// Hash Map node to store structural counts of elements
typedef struct MapNode {
    int key;
    int value;
    struct MapNode* next;
} MapNode;

// Fast integer hash function
unsigned int hash(int key) {
    unsigned int h = (unsigned int)key;
    h ^= (h >> 20) ^ (h >> 12);
    return (h ^ (h >> 7) ^ (h >> 4)) % HASH_SIZE;
}

// Get the current count of an element
int map_get(MapNode** table, int key) {
    unsigned int slot = hash(key);
    MapNode* curr = table[slot];
    while (curr != NULL) {
        if (curr->key == key) {
            return curr->value;
        }
        curr = curr->next;
    }
    return 0;
}

// Set or update the count of an element
void map_set(MapNode** table, int key, int new_val) {
    unsigned int slot = hash(key);
    MapNode* curr = table[slot];
    while (curr != NULL) {
        if (curr->key == key) {
            curr->value = new_val;
            return;
        }
        curr = curr->next;
    }
    MapNode* new_node = (MapNode*)malloc(sizeof(MapNode));
    new_node->key = key;
    new_node->value = new_val;
    new_node->next = table[slot];
    table[slot] = new_node;
}

// Free memory allocation of Hash Map
void map_free(MapNode** table) {
    for (int i = 0; i < HASH_SIZE; i++) {
        MapNode* curr = table[i];
        while (curr != NULL) {
            MapNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
}

/*
 * Complete the 'freqQuery' function below.
 */
int* freqQuery(int queries_rows, int queries_columns, int** queries, int* result_count) {
    // Hash map to find the frequency of an element: element -> frequency
    MapNode** value_counts = (MapNode**)calloc(HASH_SIZE, sizeof(MapNode*));
    
    // Array to track how many values share a specific frequency: frequency -> element count
    // Given Q <= 10^5, frequency cannot exceed queries_rows + 1
    int max_possible_freq = queries_rows + 2;
    int* freq_counts = (int*)calloc(max_possible_freq, sizeof(int));
    
    // Allocate buffer dynamically for type 3 outputs
    int* results = (int*)malloc(queries_rows * sizeof(int));
    int res_idx = 0;

    for (int i = 0; i < queries_rows; i++) {
        int command = queries[i][0];
        int data = queries[i][1];

        if (command == 1) {
            int old_freq = map_get(value_counts, data);
            int new_freq = old_freq + 1;
            
            map_set(value_counts, data, new_freq);
            
            if (old_freq > 0) {
                freq_counts[old_freq]--;
            }
            if (new_freq < max_possible_freq) {
                freq_counts[new_freq]++;
            }
        } 
        else if (command == 2) {
            int old_freq = map_get(value_counts, data);
            if (old_freq > 0) {
                int new_freq = old_freq - 1;
                map_set(value_counts, data, new_freq);
                
                freq_counts[old_freq]--;
                freq_counts[new_freq]++;
            }
        } 
        else if (command == 3) {
            if (data >= max_possible_freq) {
                results[res_idx++] = 0;
            } else {
                results[res_idx++] = (freq_counts[data] > 0) ? 1 : 0;
            }
        }
    }

    // Clean up auxiliary storage structures
    map_free(value_counts);
    free(value_counts);
    free(freq_counts);

    *result_count = res_idx;
    return results;
}

int main()
{
    FILE* fptr = fopen(getenv("OUTPUT_PATH"), "w");
    if (fptr == NULL) {
        fptr = stdout;
    }

    char* q_endptr;
    char* q_str = ltrim(rtrim(readline()));
    int q = strtol(q_str, &q_endptr, 10);

    if (q_endptr == q_str || *q_endptr != '\0') { exit(EXIT_FAILURE); }

    int** queries = malloc(q * sizeof(int*));

    for (int i = 0; i < q; i++) {
        *(queries + i) = malloc(2 * (sizeof(int)));

        char** queries_item_temp = split_string(rtrim(readline()));

        for (int j = 0; j < 2; j++) {
            char* queries_item_endptr;
            char* queries_item_str = *(queries_item_temp + j);
            int queries_item = strtol(queries_item_str, &queries_item_endptr, 10);

            if (queries_item_endptr == queries_item_str || *queries_item_endptr != '\0') { exit(EXIT_FAILURE); }

            *(*(queries + i) + j) = queries_item;
        }
    }

    int queries_rows = q;
    int queries_columns = 2;

    int ans_count;
    int* ans = freqQuery(queries_rows, queries_columns, queries, &ans_count);

    for (int i = 0; i < ans_count; i++) {
        fprintf(fptr, "%d", *(ans + i));

        if (i != ans_count - 1) {
            fprintf(fptr, "\n");
        }
    }

    fprintf(fptr, "\n");

    // Clear main inputs memory safely
    for(int i = 0; i < q; i++) {
        free(queries[i]);
    }
    free(queries);
    free(ans);

    if (fptr != stdout) {
        fclose(fptr);
    }

    return 0;
}

char* readline() {
    size_t alloc_length = 1024;
    size_t data_length = 0;
    char* data = malloc(alloc_length);

    while (true) {
        char* cursor = data + data_length;
        char* line = fgets(cursor, alloc_length - data_length, stdin);

        if (!line) {
            break;
        }

        data_length += strlen(cursor);

        if (data_length < alloc_length - 1 || data[data_length - 1] == '\n') {
            break;
        }

        alloc_length <<= 1;
        data = realloc(data, alloc_length);

        if (!data) {
            data = '\0';
            break;
        }
    }

    if (data_length == 0) return NULL;

    if (data[data_length - 1] == '\n') {
        data[data_length - 1] = '\0';
        data = realloc(data, data_length);
    } else {
        data = realloc(data, data_length + 1);
        if (data) {
            data[data_length] = '\0';
        }
    }

    return data;
}

char* ltrim(char* str) {
    if (!str || !*str) {
        return str;
    }
    while (*str != '\0' && isspace(*str)) {
        str++;
    }
    return str;
}

char* rtrim(char* str) {
    if (!str || !*str) {
        return str;
    }
    char* end = str + strlen(str) - 1;
    while (end >= str && isspace(*end)) {
        end--;
    }
    *(end + 1) = '\0';
    return str;
}

char** split_string(char* str) {
    char** splits = NULL;
    char* token = strtok(str, " ");
    int spaces = 0;

    while (token) {
        splits = realloc(splits, sizeof(char*) * ++spaces);
        if (!splits) {
            return splits;
        }
        splits[spaces - 1] = token;
        token = strtok(NULL, " ");
    }

    return splits;
}
