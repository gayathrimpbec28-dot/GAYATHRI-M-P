#include <stack>

class MyQueue {
private:
    std::stack<int> in_stk;
    std::stack<int> out_stk;

    // Helper function to move elements from in_stk to out_stk when out_stk is empty
    void shiftStacks() {
        if (out_stk.empty()) {
            while (!in_stk.empty()) {
                out_stk.push(in_stk.top());
                in_stk.pop();
            }
        }
    }

public:
    MyQueue() {
        // Constructor
    }
    
    // Pushes element x to the back of the queue.
    void push(int x) {
        in_stk.push(x);
    }
    
    // Removes the element from the front of the queue and returns it.
    int pop() {
        shiftStacks();
        int front_element = out_stk.top();
        out_stk.pop();
        return front_element;
    }
    
    // Returns the element at the front of the queue.
    int peek() {
        shiftStacks();
        return out_stk.top();
    }
    
    // Returns true if the queue is empty, false otherwise.
    bool empty() {
        return in_stk.empty() && out_stk.empty();
    }
};
