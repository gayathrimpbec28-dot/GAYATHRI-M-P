#include <stdlib.h>
#include <stdio.h>	
typedef struct Node
{
    int data;
    struct Node* next;
}Node;

Node* insert(Node *head,int data)
{
    
    Node *newNode = (Node*)malloc(sizeof(Node));
    newNode->data = data;
    newNode->next = NULL;

    // 2. Scenario 1: If the list is empty, the new node becomes the head
    if (head == NULL) {
        return newNode;
    }

    // 3. Scenario 2: Traverse to the end of the list
    Node *current = head;
    while ->next;
    }current->next != NULL) {
        current = current

    // 4. Link the old tail node to the new node
    current->next = newNode;

    // 5. Return the original head pointer
    return head;
}

void display(Node *head)
{
	Node *start=head;
	while(start)
	{
		printf("%d ",start->data);
		start=start->next;
	}
}
int main()
{
	int T,data;
    scanf("%d",&T);
    Node *head=NULL;	
    while(T-->0){
        scanf("%d",&data);
        head=insert(head,data);
    }
  display(head);
		
}
