#include <stdbool.h>
#include <stdlib.h>

// Step 1: Define the structure properties
typedef struct {
    int* data;     // Array memory to hold the numbers
    int head;      // Track index of the front element
    int tail;      // Track index of the next empty slot
    int capacity;  // Maximum capacity limit 
    int size;      // Total elements currently in queue
} MyCircularQueue;

// Step 2: Allocate memory and initialize variables
MyCircularQueue* myCircularQueueCreate(int k) {
    MyCircularQueue* obj = (MyCircularQueue*)malloc(sizeof(MyCircularQueue));
    obj->data = (int*)malloc(k * sizeof(int));
    obj->head = 0;
    obj->tail = 0;
    obj->capacity = k;
    obj->size = 0;
    return obj;
}

// Step 3: Check if empty
bool myCircularQueueIsEmpty(MyCircularQueue* obj) {
    return obj->size == 0;
}

// Step 4: Check if full
bool myCircularQueueIsFull(MyCircularQueue* obj) {
    return obj->size == obj->capacity;
}

// Step 5: Insert element at the tail
bool myCircularQueueEnQueue(MyCircularQueue* obj, int value) {
    if (myCircularQueueIsFull(obj)) {
        return false;
    }
    obj->data[obj->tail] = value;
    obj->tail = (obj->tail + 1) % obj->capacity; // Modulo wraps index to 0
    obj->size++;
    return true;
}

// Step 6: Delete element from the head
bool myCircularQueueDeQueue(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return false;
    }
    obj->head = (obj->head + 1) % obj->capacity; // Modulo wraps index to 0
    obj->size--;
    return true;
}

// Step 7: Get the front item
int myCircularQueueFront(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->head];
}

// Step 8: Get the rear item
int myCircularQueueRear(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    // (tail - 1 + capacity) avoids negative indices before modulo wrapping
    int rearIndex = (obj->tail - 1 + obj->capacity) % obj->capacity;
    return obj->data[rearIndex];
}

// Step 9: Clean up all memory leaks
void myCircularQueueFree(MyCircularQueue* obj) {
    free(obj->data);
    free(obj);
}
